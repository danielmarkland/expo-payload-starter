{
  "name": "@starter/site",
  "version": "1.0.14",
  "private": true,
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate": "pnpm generate:types && pnpm generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/runMigrations.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "site:transfer": "tsx src/scripts/site-transfer.ts",
    "test:site-transfer": "vitest run --config tests/site-transfer/vitest.config.mts",
    "auth:migrate-editors": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate-editor-identities.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@danielmarkland/auth-runtime": "workspace:*",
    "@danielmarkland/contracts": "workspace:*",
    "@danielmarkland/design-tokens": "workspace:*",
    "@danielmarkland/publishing-contracts": "workspace:*",
    "@danielmarkland/publishing-core": "workspace:*",
    "@danielmarkland/publishing-ui": "workspace:*",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@starter/api-client": "workspace:*",
    "@starter/brand": "workspace:*",
    "@starter/data": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "hono": "^4.9.8",
    "lucide-react": "^1.48.0",
    "next": "16.3.3",
    "payload": "3.90.2",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@payloadcms/plugin-cloud-storage": "3.90.2",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "sass": "1.77.4",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
