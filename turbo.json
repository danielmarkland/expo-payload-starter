{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AUTH_TEST_DATABASE_URL",
    "DATABASE_URL",
    "CONTACT_TO_ADDRESS",
    "EMAIL_FROM_ADDRESS",
    "EXPO_PUBLIC_SITE_URL",
    "MAILERLITE_API_KEY",
    "PAYLOAD_SECRET",
    "RESEND_API_KEY",
    "SITE_URL",
    "TURNSTILE_SECRET_KEY",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "AUTH_SECRET",
    "AUTH_TENANT_ID",
    "AUTH_TRUSTED_ORIGINS",
    "AUTH_*",
    "EDITOR_AUTH_*",
    "PRODUCT_AUTH_TEST_DATABASE_URL",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_ENDPOINT_URL_S3",
    "AWS_REGION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@danielmarkland/auth-runtime#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@starter/site#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@starter/site#build": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
