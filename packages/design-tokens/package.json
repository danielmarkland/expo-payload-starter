{
  "name": "@danielmarkland/design-tokens",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./fonts/*": "./assets/fonts/*"
  },
  "files": [
    "dist",
    "src/theme.css",
    "assets/fonts"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielmarkland/expo-payload-starter.git",
    "directory": "packages/design-tokens"
  },
  "scripts": {
    "build": "pnpm clean && node scripts/generate-theme-css.mjs --check && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate:css": "node scripts/generate-theme-css.mjs",
    "lint": "node scripts/generate-theme-css.mjs --check && tsc --noEmit",
    "test": "vitest run --passWithNoTests --dir src",
    "typecheck": "node scripts/generate-theme-css.mjs --check && tsc --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
