{
  "name": "@starter/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./assets/*": "./assets/*",
    "./brand.json": "./src/brand.json"
  },
  "files": [
    "dist",
    "src/theme.css",
    "src/brand.json",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/generate-theme-css.mjs --check && tsc -p tsconfig.json",
    "generate:css": "node scripts/generate-theme-css.mjs",
    "lint": "node scripts/generate-theme-css.mjs --check && tsc --noEmit",
    "test": "vitest run --passWithNoTests --dir src",
    "typecheck": "node scripts/generate-theme-css.mjs --check && tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
