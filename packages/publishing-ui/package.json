{
  "name": "@danielmarkland/publishing-ui",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielmarkland/expo-payload-starter.git",
    "directory": "packages/publishing-ui"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "test:package": "pnpm build && node --test tests/package.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@danielmarkland/publishing-contracts": "workspace:*",
    "lucide-react": "^1.48.0"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "next": "^16.3.3",
    "payload": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "react-dom": "^19.2.6"
  },
  "peerDependenciesMeta": {
    "payload": {
      "optional": true
    },
    "@payloadcms/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "next": "16.3.3",
    "payload": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.9",
    "typescript": "5.7.3",
    "vitest": "^4.0.18",
    "@testing-library/react": "16.3.0",
    "jsdom": "28.0.0",
    "@payloadcms/next": "3.90.2",
    "@playwright/test": "1.58.2",
    "sass": "1.77.4"
  }
}
