  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielmarkland/expo-payload-starter.git",
    "directory": "packages/publishing-core"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@danielmarkland/design-tokens": "workspace:*",
    "@danielmarkland/publishing-contracts": "workspace:*"
  },
  "peerDependencies": {
    "@payloadcms/richtext-lexical": "3.90.2",
    "payload": "3.90.2"
  },
  "devDependencies": {
    "@payloadcms/richtext-lexical": "3.90.2",
    "payload": "3.90.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "peerDependenciesMeta": {
    "@payloadcms/richtext-lexical": {
      "optional": true
    },
    "payload": {
      "optional": true
    }
  }
