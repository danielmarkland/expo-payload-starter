    },
    "./payloadFields": {
      "types": "./dist/payloadFields.d.ts",
      "default": "./dist/payloadFields.js"
    },
    "./payloadBlocks": {
      "types": "./dist/payloadBlocks.d.ts",
      "default": "./dist/payloadBlocks.js"
    },
    "./payloadEditorial": {
      "types": "./dist/payloadEditorial.d.ts",
      "default": "./dist/payloadEditorial.js"
    },
    "./payloadNavigation": {
      "types": "./dist/payloadNavigation.d.ts",
