  "version": "0.7.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./buttonVariants": {
      "types": "./dist/buttonVariants.d.ts",
      "default": "./dist/buttonVariants.js"
    },
