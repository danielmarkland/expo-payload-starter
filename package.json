{
  "name": "expo-payload-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node packages/config/scripts/start.mjs",
    "dev:app": "pnpm --filter @starter/app dev",
    "dev:app:web": "pnpm --filter @starter/app web",
    "dev:site": "pnpm --filter @starter/site dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "turbo run generate",
    "generate:payload": "pnpm --filter @starter/site generate",
    "lint": "node packages/config/scripts/check-boundaries.mjs && turbo run lint",
    "payload:migrate": "pnpm --filter @starter/site migrate",
    "payload:migrate:create": "pnpm --filter @starter/site payload migrate:create",
    "payload:migrate:status": "pnpm --filter @starter/site payload migrate:status",
    "setup": "node packages/config/scripts/setup.mjs",
    "setup:hosted": "node packages/config/scripts/setup.mjs --mode hosted",
    "test": "node --test scripts/payload-document-lock.test.mjs && pnpm test:release && turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @danielmarkland/contracts build && pnpm --filter @danielmarkland/design-tokens build && pnpm --filter @danielmarkland/publishing-contracts build && pnpm --filter @danielmarkland/publishing-core build && pnpm --filter @danielmarkland/publishing-ui build && pnpm --filter @danielmarkland/auth-runtime build && changeset publish",
    "test:release": "node --test scripts/release/*.test.mjs scripts/database/*.test.mjs",
    "database:migrate": "node scripts/database/migrate.mjs",
    "storage:init": "node scripts/database/init-storage.mjs",
    "clean:cache": "node -e \"for (const p of ['.turbo','apps/site/.next','apps/app/.expo']) require('node:fs').rmSync(p,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "@neon/config": "^1.8.6"
  }
}
